---
import type { GetStaticPaths } from 'astro';
import CasePage from '../../views/CasePage.astro';
import { getProjects, type Project } from '../../lib/projects';

export const getStaticPaths = (async () => {
  const projects = await getProjects('pt');
  return projects.filter((p) => p.data.hasCase).map((project) => ({ params: { slug: project.data.slug }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props as { project: Project };
---

<CasePage lang="pt" project={project} />
