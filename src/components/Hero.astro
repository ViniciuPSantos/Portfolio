---
import Prompt from './Prompt.astro';
import { routes, t, otherLang, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const alt = otherLang(lang);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="intro">
    <Prompt cmd="whoami" />
    <h1 id="hero-title">Vinicius Santos</h1>
    <p class="tagline">{d.hero.tagline}</p>
    <ul class="facts" role="list">
      {d.hero.facts.map((f) => <li>{f}</li>)}
    </ul>
    <p class="available"><span class="dot dot-lg" aria-hidden="true"></span>{d.hero.available}</p>
    <div class="ctas">
      <a class="btn btn-primary" href={`#${d.ids.projects}`}>{d.hero.ctaProjects}</a>
      <a class="btn btn-outline" href={routes.cv(lang)} download>
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        {d.hero.ctaCv}
        <span class="sr-only">(PDF, {lang.toUpperCase()})</span>
      </a>
      <a class="cv-alt" href={routes.cv(alt)} download hreflang={alt === 'pt' ? 'pt-BR' : 'en'}>
        {alt.toUpperCase()}<span class="sr-only"> — {d.hero.ctaCvAlt} (PDF)</span>
      </a>
      <a class="talk" href={`#${d.ids.contact}`}>{d.hero.ctaContact}</a>
    </div>
  </div>

  <div class="window" aria-hidden="true">
    <div class="titlebar">
      <span class="light"></span><span class="light"></span><span class="light"></span>
      <span class="wtitle">{d.hero.window}</span>
    </div>
    <div class="screen">
      {
        d.hero.lines.map((l) => (
          <>
            <div>
              <span class="accent">$</span> {l.cmd}
            </div>
            {l.out.map((o) => (
              <div class="out">{o}</div>
            ))}
            <div class="gap" />
          </>
        ))
      }
      <div><span class="accent">$</span> <span class="caret"></span></div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 96px 0 112px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 56px;
  }

  @media (max-width: 720px) {
    .hero {
      padding: 56px 0 72px;
      gap: 40px;
    }
  }

  .intro {
    flex: 1 1 480px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  h1 {
    font-family: var(--font-mono);
    font-size: clamp(40px, 6vw, 68px);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .tagline {
    font-size: 20px;
    line-height: 1.55;
    color: var(--text-muted);
    max-width: 560px;
  }

  @media (max-width: 480px) {
    .tagline {
      font-size: 18px;
    }
  }

  .facts {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-muted);
  }

  .facts li {
    padding: 6px 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }

  .available {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-muted);
  }

  .dot-lg {
    width: 8px;
    height: 8px;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    padding-top: 8px;
  }

  .cv-alt {
    min-height: 44px;
    min-width: 44px;
    margin-left: -8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-muted);
  }

  .talk {
    min-height: 44px;
    padding: 0 8px;
    display: flex;
    align-items: center;
    color: var(--text-muted);
    font-size: 15px;
  }

  .talk:hover,
  .cv-alt:hover {
    color: var(--text);
  }

  .window {
    flex: 1 1 400px;
    min-width: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    overflow: hidden;
  }

  .titlebar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border-soft);
  }

  .light {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--border-strong);
  }

  .wtitle {
    margin-left: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-dim);
  }

  .screen {
    padding: 20px 20px 24px;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }

  .out {
    color: var(--text-muted);
  }

  .gap {
    height: 12px;
  }

  .caret {
    display: inline-block;
    width: 9px;
    height: 17px;
    vertical-align: -3px;
    background: var(--text);
  }

  @media (prefers-reduced-motion: no-preference) {
    .caret {
      animation: blink 1.1s steps(1) infinite;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
