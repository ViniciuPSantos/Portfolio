---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
// Preload só do subset latino (o usado no conteúdo); os demais carregam sob demanda via unicode-range.
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import monoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Terminal from '../components/Terminal.astro';
import { site } from '../data/site';
import { otherLang, pathFor, t, type Lang, type PageRef } from '../i18n/utils';

interface Props {
  lang: Lang;
  page: PageRef;
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const { lang, page, title, description, ogType = 'website', noindex = false } = Astro.props;
const d = t(lang);
const alt = otherLang(lang);

const canonical = new URL(pathFor(lang, page), site.url).href;
const alternates = {
  pt: new URL(pathFor('pt', page), site.url).href,
  en: new URL(pathFor('en', page), site.url).href,
};
const ogImage = new URL(`/og/og-${lang}.png`, site.url).href;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  jobTitle: d.meta.jobTitle,
  worksFor: { '@type': 'Organization', name: 'XP Inc.' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universidade São Judas Tadeu' },
  address: { '@type': 'PostalAddress', addressLocality: 'São Paulo', addressCountry: 'BR' },
  knowsAbout: ['Java', 'Spring Boot', 'C#', '.NET', 'Python', 'PostgreSQL', 'MongoDB', 'Docker'],
  sameAs: [site.github.url, site.linkedin.url],
};
---

<!doctype html>
<html lang={d.meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {
      !noindex && (
        <>
          <link rel="alternate" hreflang="pt-BR" href={alternates.pt} />
          <link rel="alternate" hreflang="en" href={alternates.en} />
          <link rel="alternate" hreflang="x-default" href={alternates.pt} />
        </>
      )
    }
    <meta name="theme-color" content="#0A0A0A" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.domain} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={d.meta.ogLocale} />
    <meta property="og:locale:alternate" content={t(alt).meta.ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">{d.a11y.skip}</a>
    <Header lang={lang} page={page} />
    <main id="conteudo" class="container" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <Terminal lang={lang} page={page} />
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
