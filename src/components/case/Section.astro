---
/** Seção numerada do case study (01, 02…). Usada no MDX. */
interface Props {
  n: string;
  title: string;
}

const { n, title } = Astro.props;
const id = `secao-${n}`;
---

<section class="cs" aria-labelledby={id}>
  <p class="num" aria-hidden="true">{n}</p>
  <div class="content">
    <h2 id={id}>{title}</h2>
    <slot />
  </div>
</section>

<style>
  .cs {
    padding: 80px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 16px 48px;
  }

  @media (max-width: 720px) {
    .cs {
      padding-top: 56px;
    }
  }

  .num {
    flex: 0 0 160px;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--accent-text);
  }

  .content {
    flex: 1 1 560px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  h2 {
    font-family: var(--font-mono);
    font-size: 26px;
    font-weight: 700;
    line-height: 1.25;
  }

  @media (max-width: 480px) {
    h2 {
      font-size: 22px;
    }
  }
</style>
