# Token fine-grained do GitHub, somente leitura, acesso apenas a repositórios públicos.
# Usado só no servidor por src/pages/api/github.ts.
GITHUB_TOKEN=

# Resend (https://resend.com). O domínio do remetente precisa estar verificado.
RESEND_API_KEY=
# Para onde as mensagens do formulário são enviadas.
CONTACT_TO_EMAIL=
# Remetente no domínio verificado, ex.: "Portfólio <contato@viniciusps.tech>"
CONTACT_FROM_EMAIL=
