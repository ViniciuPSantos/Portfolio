---
import Prompt from './Prompt.astro';
import { t, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const d = t(Astro.props.lang);
---

<section id={d.ids.stack} class="section" aria-labelledby="stack-title">
  <div class="section-head">
    <Prompt cmd={d.stack.prompt} />
    <h2 id="stack-title" class="section-title">{d.stack.title}</h2>
  </div>
  <div class="groups">
    {
      d.stack.groups.map((g) => (
        <div class="group">
          <h3 class="label">{g.label}</h3>
          <ul class="items" role="list">
            {g.items.map((i) => (
              <li>{i}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .groups {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    font-family: var(--font-mono);
  }

  .group {
    flex: 1 1 240px;
    min-width: 0;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .label {
    font-size: 13px;
    font-weight: 400;
    color: var(--accent-text);
  }

  .items {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
    line-height: 1.9;
    color: var(--text);
  }
</style>
