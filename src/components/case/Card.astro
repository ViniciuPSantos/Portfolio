---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="card">
  <h3>{title}</h3>
  <div class="text"><slot /></div>
</div>

<style>
  .card {
    flex: 1 1 260px;
    min-width: 0;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  h3 {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.4;
  }

  .text {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .text :global(p) {
    margin: 0;
  }

  .text :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    color: var(--text);
  }
</style>
