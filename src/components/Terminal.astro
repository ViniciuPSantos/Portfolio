---
import { site } from '../data/site';
import { getProjects } from '../lib/projects';
import { otherLang, pathFor, routes, t, type Lang, type PageRef } from '../i18n/utils';

interface Props {
  lang: Lang;
  page: PageRef;
}

const { lang, page } = Astro.props;
const d = t(lang);
const projects = await getProjects(lang);

const data = {
  lang,
  t: d.terminal,
  langPaths: { pt: pathFor('pt', page), en: pathFor('en', page) },
  cv: { pt: routes.cv('pt'), en: routes.cv('en') },
  contact: [
    `email      ${site.email}`,
    `github     ${site.github.url.replace('https://', '')}`,
    `linkedin   ${site.linkedin.url.replace('https://www.', '')}`,
  ],
  projects: projects.map((p) => ({
    slug: p.data.slug,
    title: p.data.title,
    url: p.data.hasCase ? routes.project(lang, p.data.slug) : (p.data.links.repo ?? p.data.links.site ?? null),
    hasCase: p.data.hasCase,
  })),
};

const shortcuts = ['help', 'whoami', d.terminal.lsCommand, d.terminal.stackCommand, d.terminal.contactCommand];
const other = otherLang(lang);
---

<dialog class="term" aria-labelledby="term-title" data-terminal>
  <div class="frame">
    <div class="titlebar">
      <div class="title-left">
        <span class="light" aria-hidden="true"></span>
        <span class="light" aria-hidden="true"></span>
        <span class="light" aria-hidden="true"></span>
        <h2 id="term-title">{d.terminal.title}</h2>
      </div>
      <button type="button" class="close" data-terminal-close>
        {d.terminal.close}<span class="kbd" aria-hidden="true">Esc</span>
      </button>
    </div>

    <div class="screen" data-terminal-screen>
      <div class="log" role="log" aria-live="polite" data-terminal-log>
        {d.terminal.welcome.map((line) => <div class="line out">{line}</div>)}
      </div>
      <form class="prompt-row" data-terminal-form>
        <label for="term-input" class="ps1">
          <span class="user">{d.terminal.user}</span><span class="path">:~$</span>
          <span class="sr-only">{d.terminal.inputLabel}</span>
        </label>
        <input
          id="term-input"
          type="text"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          enterkeyhint="send"
          placeholder={d.terminal.placeholder}
          data-terminal-input
        />
      </form>
    </div>

    <div class="shortcuts">
      <span class="label">{d.terminal.shortcuts}</span>
      {
        shortcuts.map((c) => (
          <button type="button" data-terminal-run={c}>
            {c}
          </button>
        ))
      }
      <button type="button" data-terminal-run={`cv ${lang}`}>cv {lang}</button>
      <button type="button" data-terminal-run={`lang ${other}`}>lang {other}</button>
    </div>
  </div>
</dialog>

<script is:inline type="application/json" id="terminal-data" set:html={JSON.stringify(data)} />

<script>
  type Line = { kind: 'out' | 'err'; text: string };
  type Data = {
    lang: 'pt' | 'en';
    t: Record<string, string | string[]>;
    langPaths: Record<'pt' | 'en', string>;
    cv: Record<'pt' | 'en', string>;
    contact: string[];
    projects: { slug: string; title: string; url: string | null; hasCase: boolean }[];
  };

  const dialog = document.querySelector<HTMLDialogElement>('[data-terminal]');
  const dataEl = document.getElementById('terminal-data');

  if (dialog && dataEl) {
    const data = JSON.parse(dataEl.textContent ?? '{}') as Data;
    const s = (key: string) => data.t[key] as string;
    const list = (key: string) => data.t[key] as string[];
    const fill = (tpl: string, vars: Record<string, string>) => tpl.replace(/\{(\w+)\}/g, (_, k: string) => vars[k] ?? '');

    const log = dialog.querySelector<HTMLElement>('[data-terminal-log]')!;
    const screen = dialog.querySelector<HTMLElement>('[data-terminal-screen]')!;
    const form = dialog.querySelector<HTMLFormElement>('[data-terminal-form]')!;
    const input = dialog.querySelector<HTMLInputElement>('[data-terminal-input]')!;

    const history: string[] = [];
    let historyIndex = 0;
    let opener: HTMLElement | null = null;

    // Mostra "⌘ K" em vez de "Ctrl K" no macOS/iOS.
    const isMac = /Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent);
    if (isMac) document.querySelectorAll('[data-shortcut-label]').forEach((el) => (el.textContent = '⌘ K'));

    const commandNames = [
      'help',
      'whoami',
      'ls projetos',
      'ls projects',
      'cat stack',
      'contato',
      'contact',
      'cv pt',
      'cv en',
      'lang pt',
      'lang en',
      'clear',
      ...data.projects.map((p) => `open ${p.slug}`),
    ];

    function scrollToEnd() {
      screen.scrollTop = screen.scrollHeight;
    }

    function append(lines: Line[], cmd?: string) {
      const frag = document.createDocumentFragment();
      if (cmd !== undefined) {
        const row = document.createElement('div');
        row.className = 'line cmd';
        const user = document.createElement('span');
        user.className = 'user';
        user.textContent = s('user');
        const path = document.createElement('span');
        path.className = 'path';
        path.textContent = ':~$ ';
        row.append(user, path, document.createTextNode(cmd));
        frag.append(row);
      }
      for (const l of lines) {
        const div = document.createElement('div');
        div.className = `line ${l.kind}`;
        div.textContent = l.text;
        frag.append(div);
      }
      log.append(frag);
      scrollToEnd();
    }

    const out = (...texts: string[]): Line[] => texts.map((text) => ({ kind: 'out', text }));
    const err = (text: string): Line[] => [{ kind: 'err', text }];

    function download(url: string) {
      const a = document.createElement('a');
      a.href = url;
      a.download = url.split('/').pop() ?? '';
      document.body.append(a);
      a.click();
      a.remove();
    }

    function run(raw: string): Line[] | null {
      const cmd = raw.trim().replace(/\s+/g, ' ');
      const lower = cmd.toLowerCase();
      const [name = '', ...args] = lower.split(' ');
      const arg = args.join(' ').replace(/\/$/, '');

      if (lower === '') return [];
      if (lower === 'clear') {
        log.replaceChildren();
        return null;
      }
      if (lower === 'help') return out(...list('help'));
      if (lower === 'whoami') return out(...list('whoami'));
      if (name === 'ls' && (arg === '' || arg === 'projetos' || arg === 'projects')) {
        return out(data.projects.map((p) => `${p.slug}/`).join('  '));
      }
      if (lower === 'cat stack' || lower === 'stack') return out(...list('stack'));
      if (lower === 'contato' || lower === 'contact') return out(...data.contact);
      if (name === 'cv') {
        const l = arg === 'pt' || arg === 'en' ? arg : arg === '' ? data.lang : null;
        if (!l) return err(fill(s('notFound'), { cmd }));
        const url = data.cv[l];
        download(url);
        return out(fill(s('cvDownloading'), { file: url.split('/').pop() ?? '' }));
      }
      if (name === 'open' || name === 'cd') {
        const names = data.projects.map((p) => p.slug).join(', ');
        if (!arg) return out(fill(s('openUsage'), { list: names }));
        const project = data.projects.find((p) => p.slug === arg || p.title.toLowerCase() === arg);
        if (!project || !project.url) return err(fill(s('openUnknown'), { name: arg }));
        if (project.hasCase) {
          setTimeout(() => (window.location.href = project.url!), 300);
          return out(fill(s('opening'), { name: project.slug }));
        }
        window.open(project.url, '_blank', 'noopener');
        return out(fill(s('noCase'), { name: project.slug }));
      }
      if (name === 'lang') {
        if (arg !== 'pt' && arg !== 'en') return out(s('langUsage'));
        if (arg !== data.lang) setTimeout(() => (window.location.href = data.langPaths[arg]), 300);
        return out(fill(s('langSwitching'), { lang: arg }));
      }
      if (name === 'sudo') return err(s('sudo'));
      return err(fill(s('notFound'), { cmd }));
    }

    function execute(raw: string) {
      if (raw.trim()) {
        history.push(raw);
      }
      historyIndex = history.length;
      const result = run(raw);
      if (result) append(result, raw);
      input.value = '';
    }

    function open() {
      if (dialog!.open) return;
      opener = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      dialog!.showModal();
      input.focus();
      scrollToEnd();
    }

    dialog.addEventListener('close', () => {
      opener?.focus();
      opener = null;
    });

    // Clique fora da janela (no backdrop) fecha.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      execute(input.value);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowUp' || e.key === 'ArrowDown') {
        if (!history.length) return;
        e.preventDefault();
        historyIndex = Math.max(0, Math.min(history.length, historyIndex + (e.key === 'ArrowUp' ? -1 : 1)));
        input.value = history[historyIndex] ?? '';
        input.setSelectionRange(input.value.length, input.value.length);
        return;
      }
      // Tab completa o comando quando há texto; com o campo vazio, Tab navega normalmente.
      if (e.key === 'Tab' && !e.shiftKey && input.value.trim()) {
        const typed = input.value.trimStart().toLowerCase();
        const matches = [...new Set(commandNames.filter((c) => c.startsWith(typed)))];
        if (matches.length === 0) return;
        e.preventDefault();
        if (matches.length === 1) {
          input.value = matches[0]!;
        } else {
          // Completa o prefixo comum e mostra as opções.
          let prefix = matches[0]!;
          for (const m of matches) while (!m.startsWith(prefix)) prefix = prefix.slice(0, -1);
          if (prefix.length > typed.length) input.value = prefix;
          else append(out(matches.join('  ')));
        }
      }
    });

    dialog.querySelectorAll<HTMLButtonElement>('[data-terminal-run]').forEach((btn) =>
      btn.addEventListener('click', () => {
        execute(btn.dataset.terminalRun ?? '');
        input.focus();
      }),
    );

    dialog.querySelector('[data-terminal-close]')?.addEventListener('click', () => dialog.close());

    document.querySelectorAll<HTMLElement>('[data-terminal-open]').forEach((btn) => btn.addEventListener('click', open));

    document.addEventListener('keydown', (e) => {
      if (e.key.toLowerCase() !== 'k' || !(e.ctrlKey || e.metaKey) || e.altKey || e.shiftKey) return;
      const el = document.activeElement;
      const typing =
        el instanceof HTMLTextAreaElement ||
        el instanceof HTMLSelectElement ||
        (el instanceof HTMLInputElement && el !== input) ||
        (el instanceof HTMLElement && el.isContentEditable);
      if (typing) return;
      e.preventDefault();
      if (dialog.open) dialog.close();
      else open();
    });
  }
</script>

<style>
  .term {
    width: min(960px, calc(100vw - 32px));
    height: min(640px, calc(100dvh - 32px));
    max-width: none;
    max-height: none;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--text);
    font-family: var(--font-mono);
  }

  .term::backdrop {
    background: rgba(5, 5, 5, 0.8);
  }

  @media (prefers-reduced-motion: no-preference) {
    .term[open] .frame {
      animation: pop 0.16s ease-out;
    }
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.99);
    }
  }

  .frame {
    height: 100%;
    display: flex;
    flex-direction: column;
    border: 1px solid #2a2a2a;
    border-radius: 12px;
    background: #0e0e0e;
    overflow: hidden;
  }

  .titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 6px 8px 6px 16px;
    border-bottom: 1px solid var(--border-soft);
  }

  .title-left {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .light {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--border-strong);
    flex: none;
  }

  h2 {
    margin: 0 0 0 8px;
    font-size: 12px;
    font-weight: 400;
    color: var(--text-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .close {
    min-height: 44px;
    padding: 0 10px;
    display: flex;
    align-items: center;
    gap: 8px;
    border: none;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 12px;
    cursor: pointer;
  }

  .close:hover {
    color: var(--text);
    background: var(--surface-2);
  }

  .screen {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    padding: 20px;
    font-size: 14px;
    line-height: 1.75;
  }

  @media (max-width: 480px) {
    .screen {
      padding: 16px;
      font-size: 13px;
    }
  }

  .log :global(.line) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .log :global(.out) {
    color: var(--text-muted);
  }

  .log :global(.err) {
    color: var(--danger-text);
  }

  .log :global(.user),
  .ps1 .user {
    color: var(--accent-text);
  }

  .log :global(.path),
  .ps1 .path {
    color: var(--text-dim);
  }

  .prompt-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ps1 {
    white-space: nowrap;
  }

  input {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 32px;
    padding: 0;
    border: none;
    outline: none;
    background: transparent;
    color: var(--text);
    font: inherit;
    caret-color: var(--accent-text);
  }

  input::placeholder {
    color: var(--text-dim);
  }

  /* O foco visível fica na linha inteira, já que o input não tem borda. */
  .prompt-row:has(input:focus-visible) {
    outline: 1px solid var(--border-strong);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .shortcuts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-top: 1px solid var(--border-soft);
  }

  .label {
    margin-right: 4px;
    font-size: 12px;
    color: var(--text-dim);
  }

  .shortcuts button {
    min-height: 44px;
    padding: 0 12px;
    border: 1px solid #2a2a2a;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 12px;
    cursor: pointer;
  }

  .shortcuts button:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }

  :global(html:has(dialog.term[open])) {
    overflow: hidden;
  }
</style>
