---
/**
 * Espaço para um print dentro do case. Enquanto não há imagem, mostra o
 * texto do placeholder. Quando houver, passe `src` (import de imagem) e `alt`.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  label?: string;
  src?: ImageMetadata;
  alt?: string;
}

const { label, src, alt = '' } = Astro.props;
---

{
  src ? (
    <figure class="shot">
      <Image src={src} alt={alt} widths={[720, 1120]} sizes="(min-width: 1120px) 860px, 100vw" />
    </figure>
  ) : (
    <div class="shot placeholder-media" aria-hidden="true">
      {label}
    </div>
  )
}

<style>
  .shot {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .placeholder-media {
    min-height: 280px;
    background: var(--surface);
    font-size: 13px;
  }

  .shot :global(img) {
    width: 100%;
    height: auto;
  }
</style>
